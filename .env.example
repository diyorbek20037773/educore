# EDUCORE environment contract. Every variable the code reads is listed here with a safe default or CHANGE_ME.
# `make up` copies this file to `.env` when `.env` is missing. Never commit `.env`.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=CHANGE_ME_50_random_chars
DEBUG=true
# dev only: enable django-debug-toolbar
DEBUG_TOOLBAR=false
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8100
CSRF_TRUSTED_ORIGINS=http://localhost:8100
TIME_ZONE=Asia/Tashkent
# change in prod
ADMIN_URL_PATH=boshqaruv-7f3a9c
# optional, comma-separated CIDRs
ADMIN_IP_ALLOWLIST=
# prod only; set false for the local HTTP dry-run
SECURE_SSL_REDIRECT=true

# Dev host ports (compose.yaml only; ADR-014 — chosen to avoid clashes with other local stacks)
EDUCORE_WEB_PORT=8100
EDUCORE_DB_PORT=5442
EDUCORE_MAILPIT_PORT=8125
EDUCORE_FLOWER_PORT=5655

# Data stores
# never add ?conn_max_age= (pooling needs 0)
DATABASE_URL=postgres://educore:educore@db:5432/educore
# true ONLY in the web service (compose sets it); pool is not fork-safe
DATABASE_POOL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# used by the db container itself
POSTGRES_DB=educore
POSTGRES_USER=educore
# CHANGE_ME in prod (must match DATABASE_URL)
POSTGRES_PASSWORD=educore
# locks, heartbeat, rate limits (noeviction instance)
REDIS_URL=redis://redis:6379/0
# Django cache (allkeys-lru instance)
CACHE_URL=redis://redis-cache:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=django-db
# the compose network; X-Forwarded-For honoured only from here
TRUSTED_PROXY_CIDRS=172.16.0.0/12
MEDIA_ROOT=/data/media
# appeal attachments; never served by Caddy
PRIVATE_ROOT=/data/private

# Telegram (MTProto user session)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=CHANGE_ME
TELEGRAM_PHONE=+998XXXXXXXXX
TELEGRAM_SESSION_PATH=/data/telegram/educore.session
TELEGRAM_BACKFILL_LIMIT=500
BACKFILL_AI_LIMIT_PER_SOURCE=150
# for backfill posts beyond the AI limit: photos only, this size cap
TELEGRAM_BACKFILL_MAX_MEDIA_MB=20
TELEGRAM_MAX_MEDIA_MB=200
TELEGRAM_MEDIA_CONCURRENCY=2

# AI
# mock | anthropic
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_DAILY_USD_BUDGET=5
# empty to disable AI translations
AI_TRANSLATE_TO=ru,en
# optional override {"model": {"in": 2, "out": 10}}
AI_PRICING_JSON=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# auto = fake vectors while AI_PROVIDER=mock (offline dev), fastembed otherwise
EMBEDDING_BACKEND=auto
FASTEMBED_CACHE_DIR=/app/.cache/fastembed
# optional
PROMPT_VERSION_OVERRIDE=

# Publishing policy (SiteSetting in admin overrides these)
# auto | review | off — start prod in `review`; switch to `auto` in admin after the golden-set check
PUBLISH_MODE=review
PUBLISH_CONFIDENCE_THRESHOLD=0.75
# archive | keep
ON_SOURCE_DELETE=archive

# Media / storage
# local | s3
MEDIA_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PUBLIC_URL=

# Email
# prod: smtp+tls://user:pass@host:587
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=Educore <noreply@example.uz>
APPEALS_NOTIFY_EMAILS=

# Security / anti-abuse
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CORS_ALLOWED_ORIGINS=

# Ops
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
SENTRY_DSN=
METRICS_IP_ALLOWLIST=127.0.0.1/32,172.16.0.0/12
PROMETHEUS_MULTIPROC_DIR=/tmp/prom
LOG_LEVEL=INFO
# false = human-readable console logs in dev
LOG_JSON=true

# Backups (prod)
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# owner's age public key (age -r); private key kept offline by the owner
BACKUP_AGE_RECIPIENT=age1...

# Deploy (GitHub secrets, not in .env): DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY, GHCR_PAT (read:packages)
